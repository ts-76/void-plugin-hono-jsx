{
  "name": "void-plugin-hono-jsx",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25.0.0"
  },
  "scripts": {
    "dev": "npm run dev:pages",
    "build": "npm run build:pages",
    "preview": "npm run preview:pages",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "dev:pages": "npm --prefix examples/pages run dev",
    "build:pages": "npm --prefix examples/pages run build",
    "preview:pages": "npm --prefix examples/pages run preview",
    "build:package": "node scripts/build-package.mjs",
    "check:consumer": "node scripts/check-independent-markdown-consumer.mjs && node scripts/check-consumer.mjs",
    "check:source": "node scripts/check-source.mjs",
    "audit:release": "node scripts/audit-release.mjs",
    "dev:custom-ssr": "npm --prefix examples/custom-ssr run dev",
    "build:custom-ssr": "npm --prefix examples/custom-ssr run build",
    "preview:custom-ssr": "npm --prefix examples/custom-ssr run preview",
    "release:prepare": "node scripts/release/prepare.mjs",
    "release:plan": "node scripts/release/plan.mjs",
    "audit:history": "node scripts/audit-history.mjs",
    "audit:secrets": "bash scripts/gitleaks.sh",
    "release:verify-consumer": "node scripts/release/verify-consumer.mjs",
    "build:markdown": "node scripts/build-markdown.mjs",
    "prepare": "npm run build:markdown",
    "pretypecheck": "npm run build:markdown",
    "pretest": "npm run build:markdown"
  },
  "dependencies": {
    "hono": "4.13.13",
    "@ts-76/hono-markdown": "file:packages/hono-markdown"
  },
  "devDependencies": {
    "@jridgewell/remapping": "2.3.5",
    "@jridgewell/trace-mapping": "0.3.31",
    "@shikijs/transformers": "4.5.0",
    "@types/node": "^24.0.0",
    "magic-string": "1.4.3",
    "markdown-exit": "1.3.0",
    "markdown-it-container": "4.0.0",
    "playwright": "1.64.0",
    "shiki": "4.5.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "void": "1.1.11",
    "yaml": "2.9.1"
  },
  "license": "MIT"
}
