{
  "name": "void-hono-jsx-poc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.21.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "dev:pages": "npm --prefix examples/pages run dev",
    "build:pages": "npm --prefix examples/pages run build",
    "preview:pages": "npm --prefix examples/pages run preview"
  },
  "dependencies": { "hono": "4.13.13" },
  "devDependencies": { "void": "0.26.0", "vite": "8.3.3", "typescript": "7.0.2", "@types/node": "^24.0.0" }
}
