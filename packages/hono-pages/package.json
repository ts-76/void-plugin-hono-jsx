{
  "name": "void-plugin-hono-jsx",
  "version": "0.1.0-alpha.2",
  "private": true,
  "description": "Experimental Hono JSX Pages adapter for Void",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.21.0"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    "./plugin": {
      "types": "./dist/plugins/hono-pages.d.ts",
      "import": "./dist/plugins/hono-pages.js"
    },
    "./pages": {
      "types": "./dist/server/pages.d.ts",
      "default": "./dist/server/pages.js"
    },
    "./form": {
      "types": "./dist/server/form.d.ts",
      "default": "./dist/server/form.js"
    }
  },
  "peerDependencies": {
    "hono": ">=4.13.13 <5.0.0",
    "void": ">=0.26.1 <0.28.0",
    "vite": ">=8.0.16 <9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ts-76/void-plugin-hono-jsx.git",
    "directory": "packages/hono-pages"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "bugs": {
    "url": "https://github.com/ts-76/void-plugin-hono-jsx/issues"
  },
  "homepage": "https://github.com/ts-76/void-plugin-hono-jsx#readme",
  "keywords": [
    "void",
    "hono",
    "jsx",
    "vite",
    "ssr"
  ]
}
