{
  "name": "void-plugin-hono-jsx",
  "version": "0.9.0",
  "private": true,
  "description": "Hono JSX Pages adapter for Void",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.22.1 <25.0.0"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    "./plugin": {
      "types": "./dist/plugins/hono-jsx.d.ts",
      "import": "./dist/plugins/hono-jsx.js"
    },
    "./pages": {
      "types": "./dist/server/pages.d.ts",
      "default": "./dist/server/pages.js"
    },
    "./form": {
      "types": "./dist/server/form.d.ts",
      "default": "./dist/server/form.js"
    },
    "./markdown/plugin": {
      "types": "./dist/plugins/hono-markdown.d.ts",
      "import": "./dist/plugins/hono-markdown.js"
    },
    "./markdown": {
      "types": "./dist/server/markdown.d.ts",
      "browser": "./dist/browser/markdown.js",
      "default": "./dist/server/markdown.js"
    },
    "./theme.css": {
      "default": "./dist/theme/index.css"
    },
    "./theme-content.css": {
      "default": "./dist/theme/content.css"
    },
    "./markdown/compiler": {
      "types": "./dist/plugins/static-markdown.d.ts",
      "default": "./dist/plugins/static-markdown.js"
    },
    "./markdown/client": {
      "types": "./dist/browser/markdown-islands.d.ts",
      "import": "./dist/browser/markdown-islands.js"
    }
  },
  "peerDependencies": {
    "hono": ">=4.13.13 <5.0.0",
    "void": ">=1.2.1 <1.3.0",
    "vite": ">=8.0.16 <9.0.0",
    "markdown-exit": ">=1.3.0 <2.0.0",
    "yaml": ">=2.9.1 <3.0.0",
    "markdown-it-container": ">=4.0.0 <5.0.0",
    "shiki": ">=4.5.0 <5.0.0",
    "@shikijs/transformers": ">=4.5.0 <5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ts-76/void-plugin-hono-jsx.git",
    "directory": "packages/hono-pages"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "bugs": {
    "url": "https://github.com/ts-76/void-plugin-hono-jsx/issues"
  },
  "homepage": "https://github.com/ts-76/void-plugin-hono-jsx#readme",
  "keywords": [
    "void",
    "hono",
    "jsx",
    "vite",
    "ssr"
  ],
  "peerDependenciesMeta": {
    "markdown-exit": {
      "optional": true
    },
    "yaml": {
      "optional": true
    },
    "markdown-it-container": {
      "optional": true
    },
    "shiki": {
      "optional": true
    },
    "@shikijs/transformers": {
      "optional": true
    }
  },
  "dependencies": {
    "@ts-76/hono-markdown": "^0.1.2"
  }
}
